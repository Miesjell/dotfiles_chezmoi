command = /usr/bin/fish
copy-on-select = clipboard 
clipboard-write = allow

# ---------- Clipboard ----------
# Selection goes to both PRIMARY and the system clipboard
copy-on-select = clipboard
# Lets zellij/nvim copy via OSC 52 without prompting
clipboard-write = allow

# ---------- Comfort ----------
mouse-hide-while-typing = true
# Closing the window only detaches zellij; nothing is lost
confirm-close-surface = false
window-padding-x = 4
window-padding-y = 2

keybind = clear
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = shift+insert=paste_from_selection
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+digit_0=reset_font_size
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+comma=reload_config

background-blur = macos-glass-regular
background-opacity = 0.9
background-opacity-cells = true
cursor-color = cell-foreground
cursor-opacity = 0.75
cursor-style = block_hollow
cursor-text = cell-foreground
palette = 2=#FF94CA
palette = 4=#8E66EF
palette = 10=#FF3EF9
palette = 12=#6132F5
# theme = Purplepeter

theme = Cyberpunk
